# Temporary sever2.ru website on REG.RU
# Diagnostic safe mode: no external redirects here.
# Any redirect loop that persists must be inspected at the hosting,
# domain, SSL or upstream-proxy configuration.
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^$ - [L]
RewriteRule ^index\.html$ - [L,NC]
RewriteRule ^404\.html$ - [L,NC]
RewriteRule ^assets/ - [L,NC]
RewriteRule ^ - [R=404,L]
</IfModule>
